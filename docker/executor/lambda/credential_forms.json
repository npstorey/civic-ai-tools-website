{
  "$comment": [
    "Shared vectors for the credential removal (#516): a notebook output never carries the value of a notebook credential.",
    "Read by src/lib/notebook-credential-forms.test.ts (notebookCredentialForms, withoutCredentials in src/lib/streaming.ts)",
    "and by docker/executor/lambda/test_handler.py (credential_forms, without_credentials in handler.py).",
    "Each side must produce every expected value here; written from the TypeScript implementation."
  ],
  "forms": [
    {
      "env": {
        "SOCRATA_APP_TOKEN": "fixture-plain"
      },
      "expected": [
        [
          "fixture-plain",
          "SOCRATA_APP_TOKEN"
        ]
      ]
    },
    {
      "env": {
        "DC_API_KEY": "fixture !~*'()-_."
      },
      "expected": [
        [
          "fixture%20!~*'()-_.",
          "DC_API_KEY"
        ],
        [
          "fixture !~*'()-_.",
          "DC_API_KEY"
        ]
      ]
    },
    {
      "env": {
        "SOCRATA_APP_TOKEN": "fixture space/slash+plus?amp&eq=hash#pct%"
      },
      "expected": [
        [
          "fixture%20space%2Fslash%2Bplus%3Famp%26eq%3Dhash%23pct%25",
          "SOCRATA_APP_TOKEN"
        ],
        [
          "fixture space/slash+plus?amp&eq=hash#pct%",
          "SOCRATA_APP_TOKEN"
        ]
      ]
    },
    {
      "env": {
        "SOCRATA_APP_TOKEN": "fixture \"quote\" \\backslash"
      },
      "expected": [
        [
          "fixture%20%22quote%22%20%5Cbackslash",
          "SOCRATA_APP_TOKEN"
        ],
        [
          "fixture \\\"quote\\\" \\\\backslash",
          "SOCRATA_APP_TOKEN"
        ],
        [
          "fixture \"quote\" \\backslash",
          "SOCRATA_APP_TOKEN"
        ]
      ]
    },
    {
      "env": {
        "DC_API_KEY": "fixture\ttab\nnewline\rreturn\u0001\u001f\b\f"
      },
      "expected": [
        [
          "fixture%09tab%0Anewline%0Dreturn%01%1F%7F%08%0C",
          "DC_API_KEY"
        ],
        [
          "fixture\\ttab\\nnewline\\rreturn\\u0001\\u001f\\b\\f",
          "DC_API_KEY"
        ],
        [
          "fixture\ttab\nnewline\rreturn\u0001\u001f\b\f",
          "DC_API_KEY"
        ]
      ]
    },
    {
      "env": {
        "SOCRATA_APP_TOKEN": "fixture é ü 漢字"
      },
      "expected": [
        [
          "fixture%20%C3%A9%20%C3%BC%20%E6%BC%A2%E5%AD%97",
          "SOCRATA_APP_TOKEN"
        ],
        [
          "fixture é ü 漢字",
          "SOCRATA_APP_TOKEN"
        ]
      ]
    },
    {
      "env": {
        "DC_API_KEY": "fixture 😀 astral"
      },
      "expected": [
        [
          "fixture%20%F0%9F%98%80%20astral",
          "DC_API_KEY"
        ],
        [
          "fixture 😀 astral",
          "DC_API_KEY"
        ]
      ]
    },
    {
      "env": {
        "SOCRATA_APP_TOKEN": "fixture    separators"
      },
      "expected": [
        [
          "fixture%20%E2%80%A8%E2%80%A9%20separators",
          "SOCRATA_APP_TOKEN"
        ],
        [
          "fixture    separators",
          "SOCRATA_APP_TOKEN"
        ]
      ]
    },
    {
      "env": {
        "SOCRATA_APP_TOKEN": "fixture [] {} : , < > ` ^ | ~"
      },
      "expected": [
        [
          "fixture%20%5B%5D%20%7B%7D%20%3A%20%2C%20%3C%20%3E%20%60%20%5E%20%7C%20~",
          "SOCRATA_APP_TOKEN"
        ],
        [
          "fixture [] {} : , < > ` ^ | ~",
          "SOCRATA_APP_TOKEN"
        ]
      ]
    },
    {
      "env": {
        "SOCRATA_APP_TOKEN": "fixture-socrata",
        "DC_API_KEY": "fixture \"dc\" key"
      },
      "expected": [
        [
          "fixture%20%22dc%22%20key",
          "DC_API_KEY"
        ],
        [
          "fixture \\\"dc\\\" key",
          "DC_API_KEY"
        ],
        [
          "fixture \"dc\" key",
          "DC_API_KEY"
        ],
        [
          "fixture-socrata",
          "SOCRATA_APP_TOKEN"
        ]
      ]
    },
    {
      "env": {
        "SOCRATA_APP_TOKEN": "",
        "DC_API_KEY": "fixture-only-dc"
      },
      "expected": [
        [
          "fixture-only-dc",
          "DC_API_KEY"
        ]
      ]
    },
    {
      "env": {},
      "expected": []
    }
  ],
  "removals": [
    {
      "env": {
        "SOCRATA_APP_TOKEN": "fixture socrata/p9+\"canary\"",
        "DC_API_KEY": "fixture-dc\\p9 canary"
      },
      "text": "raw fixture socrata/p9+\"canary\" url fixture%20socrata%2Fp9%2B%22canary%22 json fixture socrata/p9+\\\"canary\\\" | raw fixture-dc\\p9 canary url fixture-dc%5Cp9%20canary json fixture-dc\\\\p9 canary",
      "expected": "raw [SOCRATA_APP_TOKEN removed] url [SOCRATA_APP_TOKEN removed] json [SOCRATA_APP_TOKEN removed] | raw [DC_API_KEY removed] url [DC_API_KEY removed] json [DC_API_KEY removed]"
    },
    {
      "env": {
        "SOCRATA_APP_TOKEN": "fixture-ab",
        "DC_API_KEY": "fixture-abc"
      },
      "text": "x fixture-abc y fixture-ab z",
      "expected": "x [DC_API_KEY removed] y [SOCRATA_APP_TOKEN removed] z"
    },
    {
      "env": {
        "SOCRATA_APP_TOKEN": "fixture-same",
        "DC_API_KEY": "fixture-same"
      },
      "text": "one fixture-same two",
      "expected": "one [SOCRATA_APP_TOKEN removed] two"
    },
    {
      "env": {
        "SOCRATA_APP_TOKEN": "fixture😀😀",
        "DC_API_KEY": "😀fixture-d"
      },
      "text": "fixture😀😀fixture-d",
      "expected": "[SOCRATA_APP_TOKEN removed]fixture-d"
    },
    {
      "env": {
        "SOCRATA_APP_TOKEN": "fixture é/ü",
        "DC_API_KEY": "fixture\n\"dc\""
      },
      "text": "a fixture%20%C3%A9%2F%C3%BC b fixture\\n\\\"dc\\\" c fixture é/ü d fixture\n\"dc\"",
      "expected": "a [SOCRATA_APP_TOKEN removed] b [DC_API_KEY removed] c [SOCRATA_APP_TOKEN removed] d [DC_API_KEY removed]"
    },
    {
      "env": {},
      "text": "nothing fixture-ab to remove",
      "expected": "nothing fixture-ab to remove"
    }
  ]
}

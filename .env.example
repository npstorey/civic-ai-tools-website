# Local-development starter environment. Copy to .env.local and fill in —
# this is the minimal set to boot `npm run dev` and exercise the app's core
# paths on your own machine.
#
# This file is deliberately NOT the full environment reference. The
# authorities on the environment are:
#
#   - scripts/preflight-env.mjs — the executable authority. It enumerates
#     every variable the app reads, resolves the three driver selectors, and
#     tiers each variable for your instance profile (presence only; it never
#     reads values). Run:  node scripts/preflight-env.mjs
#   - docs/deploy.md, "Environment reference, tier by tier" — the narrative
#     authority: what each variable does, what its absence means, and the
#     whole instance-configuration surface (driver selectors, the S3_* set,
#     the notebook executor, OIDC sign-in, KV rate limiting, instance
#     identity, branding, host topology, tuning knobs).
#
# Instance configuration lives there, not here — keeping this file a small
# local-dev quick start is what stops it drifting into a third authority.

# --- Model access (required — every query fails fast without it) ---
OPENROUTER_API_KEY=
# Any OpenAI-compatible chat-completions endpoint; unset = OpenRouter.
# The key above is the credential either way.
# MODEL_API_BASE_URL=

# --- Data sources ---
# Primary data source — REQUIRED, no fallback: every data query refuses
# without it, with an error naming this variable. Set it to the Socrata
# MCP deployment this instance should query. Pointing it at another
# operator's endpoint (the project's hosted one included) means your
# users' queries route through that host's infrastructure, not yours.
# Example: SOCRATA_MCP_URL=https://socrata-mcp.civicaitools.org
SOCRATA_MCP_URL=
# Data Commons (second data source). The hosted endpoint mandates an API
# key — free from https://apikeys.datacommons.org.
DATA_COMMONS_MCP_URL=https://api.datacommons.org/mcp
DATA_COMMONS_API_KEY=

# --- Evidence store (publish + dashboard + detail pages) ---
# DB_DRIVER selects the Postgres driver used against DATABASE_URL.
# Default is 'neon-http', which speaks Neon's serverless HTTP protocol —
# it SILENTLY NEVER REACHES a plain Postgres server over TCP. If this
# DATABASE_URL points at ordinary Postgres (not Neon), you must also set:
#   DB_DRIVER=node-postgres
# Otherwise the driver simply cannot connect, with no error naming the
# mismatch. See docs/deploy.md's "The three driver decisions" section.
DATABASE_URL=              # postgres://user:pass@host/dbname?sslmode=require
BLOB_READ_WRITE_TOKEN=     # Vercel Blob token (the default blob driver; S3: see docs/deploy.md)

# --- Evidence signing (unset = the unsigned tier: banner shows, seal/publish gated off) ---
# Generate with: npx tsx scripts/generate-signing-key.ts
EVIDENCE_SIGNING_KEY=      # Base64-encoded Ed25519 private key (PKCS8 DER)
# EVIDENCE_KEY_ID=         # kid of the active key — must match the trust registry (no default; required to sign)

# --- Instance identity (ADR-0020 / #258: REQUIRED to sign, never defaulted) --
# Signed output names your instance — origin, signer claim, platform agent.
# The five below have NO defaults: with EVIDENCE_SIGNING_KEY + EVIDENCE_KEY_ID
# set but any of these absent, every seal/publish is refused
# (instance_identity_missing, naming the missing variables). With none of the
# signing set configured the instance runs the unsigned tier, and unsigned
# surfaces honestly OMIT instance attribution. See docs/instance-setup.md.
EVIDENCE_SITE_ORIGIN=            # e.g. https://your-instance.example.org
EVIDENCE_SIGNER_BINDING_TIER=    # e.g. platform — must match your registry entry (check #14)
EVIDENCE_SIGNER_IDENTIFIER=      # e.g. platform:your-instance — must match your registry entry
EVIDENCE_SIGNER_DISPLAY_NAME=    # e.g. Your Instance Platform — must match your registry entry
EVIDENCE_PLATFORM_AGENT_TITLE=   # e.g. Your Instance — PROV agent title + notebook attribution name
# Optional overrides — each DERIVES from your values above when unset:
EVIDENCE_PUBLICATION_HOST=              # default: host of EVIDENCE_SITE_ORIGIN
EVIDENCE_TRUST_REGISTRY_CANONICAL_URL=  # default: origin + /.well-known/typed-publisher.json
EVIDENCE_TRUST_REGISTRY_LEGACY_URL=     # default: origin + /.well-known/evidence-public-keys.json; set "" to omit
EVIDENCE_PLATFORM_AGENT_ID=             # default: the publication host
EVIDENCE_PLATFORM_AGENT_URL=            # default: EVIDENCE_SITE_ORIGIN

# --- Sign-in (unlocks notebook execution, the dashboard, the higher rate limit) ---
NEXTAUTH_SECRET=           # Generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
# GitHub OAuth app (github.com/settings/developers) — or any standard OIDC
# provider instead via the OIDC_* set: docs/deploy.md "Sign-in configuration".
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Everything else the app reads — DB_DRIVER / BLOB_DRIVER / EXECUTOR_DRIVER,
# the S3_* set, the executor variables, OIDC_*, KV_*, SITE_BRAND_*, host
# topology, rate-limit and token-budget knobs — is enumerated by the
# preflight and explained tier by tier in docs/deploy.md.
# SERVE_MARKETING=1   # Serve the marketing site on hosts matching neither APP_HOST nor
#                     # MARKETING_HOST. Leave unset on an instance — unset withholds the
#                     # reference deployment's marketing pages.

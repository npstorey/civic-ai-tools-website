{
  "name": "civic-ai-tools-website",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:standalone": "BUILD_STANDALONE=1 next build && npm run check:standalone",
    "check:standalone": "node scripts/check-standalone-assets.mjs",
    "check:compose-env": "node scripts/check-compose-env.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=tap --test-reporter-destination=stdout --experimental-strip-types 'src/**/*.test.ts' 'scripts/**/*.test.mjs'",
    "sandbox:build-snapshot": "node --experimental-strip-types scripts/build-sandbox-snapshot.ts",
    "update-portals": "node scripts/update-portals.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1157.0",
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "@neondatabase/serverless": "^1.2.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.2.0",
    "@smithy/fetch-http-handler": "5.8.0",
    "@typedstandards/civic-typed-harness": "^0.11.0",
    "@typedstandards/civic-typed-router": "^0.6.0",
    "@typedstandards/produce-core": "^0.9.0",
    "@typedstandards/verify-core": "^0.15.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/kv": "^3.0.0",
    "@vercel/sandbox": "^3.9.0",
    "bpmn-js": "^18.31.1",
    "canonicalize": "^5.1.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "next-auth": "^4.24.15",
    "openai": "^7.45.0",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "undici": "6.29.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

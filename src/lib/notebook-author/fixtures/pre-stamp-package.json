          "source": [
            "# Data Analysis\n",
            "\n",
            "**Query:** How many noise complaints were filed last year?  \n",
            "**Portal:** data.cityofnewyork.us  \n",
            "**Generated:** 2026-09-04"
          ]
        },
        {
          "cell_type": "code",
          "metadata": {},
          "source": [
            "# Install dependencies (run once)\n",
            "# !pip install requests pandas\n",
            "\n",
            "import requests\n",
            "import pandas as pd"
          ],
          "outputs": [],
          "execution_count": null
        },
        {
          "cell_type": "markdown",
          "metadata": {},
          "source": [
            "## Step 1: Query 1"
          ]
        },
        {
          "cell_type": "code",
          "metadata": {},
          "source": [
            "url = \"https://data.cityofnewyork.us/resource/erm2-nwe9.json?$select=count(*)&$where=complaint_type%20like%20'Noise%25'\"\n",
            "\n",
            "response = requests.get(url)\n",
            "response.raise_for_status()\n",
            "data = response.json()\n",
            "\n",
            "df = pd.DataFrame(data)\n",
            "print(f\"Rows: {len(df)}, Columns: {len(df.columns)}\")\n",
            "df.head(10)"
          ],
          "outputs": [],
          "execution_count": null
        },
        {
          "cell_type": "markdown",
          "metadata": {},
          "source": [
            "## AI Analysis\n",
            "\n",
            "About 412,000 noise complaints were filed."
          ]
        },
        {
          "cell_type": "markdown",
